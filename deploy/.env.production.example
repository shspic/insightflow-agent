# 复制为 deploy/.env.production 后逐项替换。此文件只有占位符，直接使用会被生产门禁拒绝。
APP_NAME=InsightFlow Agent
ENV=production
DEBUG=false
LOG_LEVEL=INFO
PUBLIC_SITE_URL=https://insightflow.example.cn

INSIGHTFLOW_ROOT=/srv/insightflow
INSIGHTFLOW_VERSION=replace_with_release_version
INSIGHTFLOW_BACKEND_IMAGE=insightflow-backend:local
INSIGHTFLOW_WEB_IMAGE=insightflow-web:local

DATABASE_URL=sqlite:////app/data/insightflow.db
ALEMBIC_DATABASE_URL=sqlite:////app/data/insightflow.db
SQLITE_JOURNAL_MODE=WAL
SQLITE_BUSY_TIMEOUT_MS=30000
DATABASE_POOL_RECYCLE_SECONDS=1800
UPLOAD_DIR=/app/storage/uploads
CHART_DIR=/app/storage/charts
REPORT_DIR=/app/storage/reports
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=30

AUTH_SECRET_KEY=replace_with_generated_high_entropy_secret
AUTH_COOKIE_NAME=insightflow_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
SESSION_TTL_SECONDS=604800
CSRF_COOKIE_NAME=insightflow_csrf
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_TTL_SECONDS=3600
PASSWORD_MIN_LENGTH=14
ENABLE_LEGACY_V1_API=false
CORS_ORIGINS=https://insightflow.example.cn
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_IPS=172.30.0.10
ENABLE_HSTS=true
API_GRACEFUL_SHUTDOWN_SECONDS=60

LLM_ENABLED=true
LLM_PROVIDER=deepseek
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_MAX_RETRIES=1

TESSERACT_CMD=
OCR_LANG=chi_sim+eng
PDF_MAX_PAGES=200
IMAGE_MAX_PIXELS=20000000
PDF_OCR_MAX_PAGES=50
PDF_OCR_DPI=150
PDF_OCR_MAX_PIXELS_PER_PAGE=12000000
PDF_OCR_TIMEOUT_SECONDS=120
PDF_OCR_MIN_TEXT_CHARS=20

UPLOAD_MAX_FILE_SIZE_BYTES=20971520
UPLOAD_MAX_BATCH_FILES=10
WORKSPACE_MAX_FILES=50
USER_STORAGE_QUOTA_BYTES=209715200
USER_CONCURRENT_TASKS=1
USER_DAILY_TASKS=20
USER_DAILY_DEEPSEEK_CALLS=50
USER_MAX_WORKSPACES=20
SYSTEM_MAX_RUNNING_TASKS=1
TASK_MODEL_CALL_BUDGET=12
TASK_TOOL_CALL_BUDGET=30
REPORT_HISTORY_MAX_VERSIONS=10
REPORT_EXPORT_DAILY_LIMIT=50

WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=15
WORKER_STALE_SECONDS=60
TASK_MAX_RETRIES=1
AGENT_MAX_REPLAN_COUNT=1
AGENT_MAX_REVIEW_RETRIES=1
TASK_MAX_CLARIFICATION_ROUNDS=2
TASK_EVENT_HEARTBEAT_SECONDS=15

SESSION_RETENTION_DAYS=7
REVOKED_SESSION_RETENTION_DAYS=7
PASSWORD_RESET_RETENTION_DAYS=90
TASK_EVENT_RETENTION_DAYS=180
AGENT_RUN_RETENTION_DAYS=180
WORKSPACE_DELETE_GRACE_DAYS=30
SUPERSEDED_ASSET_RETENTION_DAYS=30
