APP_NAME=InsightFlow Agent
ENV=development
DATABASE_URL=sqlite:///./data/app.db

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=<部署时核实的可用模型名>
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
LLM_ENABLED=true
LLM_MAX_RETRIES=1

# embedding 和向量存储仅为规划配置项，当前未接入真实 Embedding 模型或 Chroma/FAISS 索引。
EMBEDDING_PROVIDER=local
VECTOR_STORE=chroma
# RAG 检索模式：tfidf（TF-IDF 余弦相似度）、keyword（关键词匹配）、auto（优先 TF-IDF，失败回退 keyword）。
# 当前未接入真实 Embedding 向量检索。vector 为旧参数兼容，实际算法与 tfidf 相同。
RAG_RETRIEVAL_MODE=auto
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100

UPLOAD_DIR=./storage/uploads
CHART_DIR=./storage/charts
REPORT_DIR=./storage/reports

# V2-03 上传安全、文件理解、关系和上下文限制
UPLOAD_MAX_FILE_SIZE_BYTES=20971520
UPLOAD_MAX_BATCH_FILES=10
WORKSPACE_MAX_FILES=50
USER_STORAGE_QUOTA_BYTES=209715200
PROFILE_SAMPLE_ROWS=200
PROFILE_SAMPLE_VALUES_PER_COLUMN=3
UNDERSTANDING_BATCH_MAX_FILES=10
UNDERSTANDING_MODEL_TEXT_LIMIT=6000
PDF_MAX_PAGES=200
IMAGE_MAX_PIXELS=20000000
RELATION_MIN_CONFIDENCE=0.60
RELATION_HIGH_CONFIDENCE=0.80
RELATION_MAX_PAIRS=100
RELATION_MODEL_MAX_CALLS=5
WORKSPACE_CONTEXT_MAX_FILES=20
WORKSPACE_CONTEXT_MAX_CHARS=30000

# V2-04 低并发持久化队列、租约和 Agent 循环上限
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=15
TASK_MAX_RETRIES=1
AGENT_MAX_REPLAN_COUNT=1
AGENT_MAX_REVIEW_RETRIES=1
TASK_MAX_CLARIFICATION_ROUNDS=2
TASK_EVENT_HEARTBEAT_SECONDS=15
TASK_MODEL_CALL_BUDGET=12
TASK_TOOL_CALL_BUDGET=30

# V2-05 集中配额
USER_CONCURRENT_TASKS=1
USER_DAILY_TASKS=20
USER_DAILY_DEEPSEEK_CALLS=50
USER_MAX_WORKSPACES=20
REPORT_HISTORY_MAX_VERSIONS=10
REPORT_EXPORT_DAILY_LIMIT=50
SYSTEM_MAX_RUNNING_TASKS=2

# 扫描 PDF OCR 安全预算
PDF_OCR_MAX_PAGES=50
PDF_OCR_DPI=150
PDF_OCR_MAX_PIXELS_PER_PAGE=12000000
PDF_OCR_TIMEOUT_SECONDS=120
PDF_OCR_MIN_TEXT_CHARS=20

# 数据保留与运行监控
WORKER_STALE_SECONDS=60
SESSION_RETENTION_DAYS=7
REVOKED_SESSION_RETENTION_DAYS=7
PASSWORD_RESET_RETENTION_DAYS=90
TASK_EVENT_RETENTION_DAYS=180
AGENT_RUN_RETENTION_DAYS=180
WORKSPACE_DELETE_GRACE_DAYS=30
SUPERSEDED_ASSET_RETENTION_DAYS=30
BACKUP_DIR=./backups

CORS_ORIGINS=http://localhost:5173

TESSERACT_CMD=
OCR_LANG=chi_sim+eng

# V2 认证。请为每个环境生成独立的高熵随机值，不要直接使用本占位符。
AUTH_SECRET_KEY=
SESSION_TTL_SECONDS=604800
AUTH_COOKIE_NAME=insightflow_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
CSRF_COOKIE_NAME=insightflow_csrf
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_TTL_SECONDS=3600
SESSION_LAST_SEEN_INTERVAL_SECONDS=300
PASSWORD_MIN_LENGTH=10

# 单机数据库限流
LOGIN_ACCOUNT_LIMIT=5
LOGIN_IP_LIMIT=20
REGISTRATION_IP_LIMIT=10
RESET_REQUEST_LIMIT=3
AUTH_RATE_WINDOW_SECONDS=900
AUTH_BLOCK_SECONDS=900

# 仅本地兼容期可开启；正式公网部署必须为 false。
ENABLE_LEGACY_V1_API=true

# production 必须 DEBUG=false、TRUST_PROXY_HEADERS=true；HSTS 只在 HTTPS production 开启。
DEBUG=false
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=
ENABLE_HSTS=false
SQLITE_JOURNAL_MODE=WAL
SQLITE_BUSY_TIMEOUT_MS=30000
DATABASE_POOL_RECYCLE_SECONDS=1800
LOG_LEVEL=INFO
API_GRACEFUL_SHUTDOWN_SECONDS=60
PUBLIC_SITE_URL=http://localhost:5173

# 阶段 5A-1：Review Tools MCP（示例值，默认关闭；生产必须使用随机强 token）
ENGINEERING_MCP_ENABLED=false
ENGINEERING_MCP_URL=http://127.0.0.1:8765/mcp
ENGINEERING_MCP_TIMEOUT_SECONDS=15
ENGINEERING_MCP_INTERNAL_TOKEN=change_me_random_token
